# Environment Configuration Template
PROJECT_NAME="Health Triage Assistant API"
ENVIRONMENT="development"
DEBUG=true

# Database Settings
# For local dev / testing fallback: sqlite+aiosqlite:///./health_triage.db
# For production PostgreSQL: postgresql+asyncpg://triage_admin:triage_pass_secret@localhost:5432/health_triage
DATABASE_URL="sqlite+aiosqlite:///./health_triage.db"

# Security & JWT
JWT_SECRET_KEY="super-secret-production-jwt-key-change-in-environment"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=60

# External AI Services
GEMINI_API_KEY="your-gemini-api-key-here"

# CORS Configuration
CORS_ORIGINS=["http://localhost:3000", "http://localhost:5173", "http://127.0.0.1:5173"]
